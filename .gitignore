# Local settings
.claude/settings.local.json

# Session kill-switch counters (per-machine run state)
.claude/.killswitch/

# macOS
.DS_Store

# Build artifacts (generated from frontend/ source via `npm run build`)
frontend/build/

# Gemini CLI extension bundle (generated by scripts/build-gemini-extension.sh)
dist/

# Python bytecode
__pycache__/
*.pyc

# AgentDB (per-machine state)
_meta/agentdb/*.db
_meta/agentdb/*.db-shm
_meta/agentdb/*.db-wal
_meta/agentdb/errors.log

# Logs
_meta/logs/

# Ephemeral state (circuit breaker, compaction markers, test-gate verdict)
_meta/.breakers/
_meta/.compact-marker
_meta/.cache/
_meta/.test-status

# Manifest runtime state (kernel-manifest activate/deactivate)
_meta/.active-manifest.json
_meta/.context-ledger

# Per-session runtime state. Machine- and session-scoped: the churn guard's per-session edit
# counters, the compaction key-term cache, the current session id, the guard install stamps.
# Seven .guard-state files were tracked before 2026-09-01, one per session that happened to run,
# an unbounded accumulation of files nothing ever reads back.
_meta/.guard-state/
_meta/.runtime/
_meta/state/
_meta/.session_id
_meta/.compact-keyterms
