{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/session-start.sh",
            "timeout": 30,
            "statusMessage": "Loading KERNEL context..."
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/autopush.sh install",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/knowledge-graph.sh install",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/autocorrect-bash.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/guard-bash.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebFetch|Read|Edit|mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/autocorrect-tool-input.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/guard-config.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/detect-secrets.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/validate-structure.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/warn-hardcoded.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/verdict-gate.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/guard-context.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/syntax-coach.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/scan-output.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/log-write.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/validate-json-schema.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/auto-approve-safe.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/context-usage.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/route-request.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/post-compact-restore.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/chronicle-gate.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/pre-compact-commit.sh",
            "timeout": 30,
            "statusMessage": "Saving context snapshot..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/scripts/session-end.sh",
            "timeout": 3,
            "statusMessage": "Closing session..."
          }
        ]
      }
    ]
  }
}
